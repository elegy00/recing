# ── Build stage ────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/schema/package.json packages/schema/
COPY packages/ingestion/package.json packages/ingestion/

RUN pnpm install --frozen-lockfile

COPY packages/schema/ packages/schema/
COPY packages/ingestion/ packages/ingestion/

RUN cd packages/schema && pnpm run build
RUN cd packages/ingestion && pnpm run build

# ── Production stage ───────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

# Copy workspace config + manifests so pnpm can resolve deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/schema/package.json packages/schema/
COPY packages/ingestion/package.json packages/ingestion/

# Install production dependencies only
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --prod --frozen-lockfile --shamefully-hoist

# Copy built artifacts
COPY --from=build /app/packages/ingestion/dist ./dist
# Schema: pnpm workspace:* resolves to .ts source, override with built dist
COPY --from=build /app/packages/schema/dist ./node_modules/@recing/schema/dist
# Write a runtime-compatible package.json for schema
RUN printf '{"name":"@recing/schema","type":"module","main":"./dist/index.js","exports":{".":{"import":"./dist/index.js"}}}' > ./node_modules/@recing/schema/package.json

EXPOSE 9090

CMD ["node", "dist/cli.js", "start"]
