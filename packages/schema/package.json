{
  "name": "@recing/schema",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-json-schema": "tsx scripts/gen-json-schema.ts",
    "prebuild": "pnpm run gen-json-schema"
  },
  "description": "Recipe domain types, Zod schemas, and validation. To regenerate the JSON Schema from the Zod schema after schema changes: pnpm run gen-json-schema",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "vitest": "^4.1.8"
  }
}
