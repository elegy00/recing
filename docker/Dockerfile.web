# ── Build stage ────────────────────────────────────────────────
# Use Debian for the build stage — Alpine (musl) lacks @oxc-parser native bindings
FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/schema/package.json packages/schema/
COPY packages/web/package.json packages/web/

RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install

COPY packages/schema/ packages/schema/
COPY packages/web/ packages/web/

RUN cd packages/schema && pnpm run build
RUN cd packages/web && pnpm run build

# ── Production stage ───────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

# Copy workspace config + manifests so pnpm can resolve deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/schema/package.json packages/schema/
COPY packages/web/package.json packages/web/

# Install production dependencies only
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --prod --frozen-lockfile --shamefully-hoist

# Copy built artifacts — TanStack Start outputs dist/server/ and dist/client/
COPY --from=build /app/packages/web/dist ./dist

# Add Node.js HTTP adapter wrapper (TanStack Start produces serverless handlers)
COPY packages/web/server.mjs .

EXPOSE 3000

CMD ["node", "server.mjs"]
