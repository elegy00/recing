# ── Build stage ────────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

# Install pnpm (Alpine doesn't have it)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace config + package manifests first (layer caching)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/schema/package.json packages/schema/
COPY packages/web/package.json packages/web/

# Install all dependencies (including dev deps for build)
RUN pnpm install --frozen-lockfile

# Copy source and build web app
COPY packages/schema/ packages/schema/
COPY packages/web/ packages/web/

RUN cd packages/schema && pnpm run build
RUN cd packages/web && pnpm run build:client && pnpm run build:server

# ── Production stage ───────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

COPY --from=build /app/packages/web/dist ./dist

EXPOSE 3000

CMD ["node", "dist/index.js"]
